# 可选的 shell 环境变量示例；应用不会自动加载 .env。
# 复制为 .env，按需修改，再在仓库根目录运行：
# set -a; . ./.env; set +a

# 相对路径以项目根目录为基准，也可以填写绝对路径。
YOLO_MODEL_PATH=models/yolov8n.pt
STORAGE_DIR=data/security_logs

# 独立部署的多模态模型服务，需提供 OpenAI 兼容接口。
VLLM_BASE_URL=http://localhost:8000/v1

# 此值是服务端模型标识，原样传给模型服务，不解析为本地路径。
VLLM_MODEL_NAME=./Qwen2.5-VL-7B-Instruct
